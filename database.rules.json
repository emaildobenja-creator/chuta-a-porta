{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChildren(['j','t']) && newData.child('j').isString() && newData.child('j').val().length < 300000 && newData.child('t').isNumber()"
      }
    }
  }
}
